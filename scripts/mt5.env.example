# Скопировать в scripts/mt5.env и поправить под себя.
# scripts/mt5.env в git не попадает.

# --- macOS + CrossOver / Wine ---
# Каталог данных терминала (там лежит папка MQL5).
# Найти: в MT5 "Файл -> Открыть каталог данных", затем сопоставить с путём в Wine-префиксе.
# MT5_DATA_DIR="$HOME/Library/Application Support/CrossOver/Bottles/MT5/drive_c/users/crossover/AppData/Roaming/MetaQuotes/Terminal/<HASH>"
# METAEDITOR="$HOME/Library/Application Support/CrossOver/Bottles/MT5/drive_c/Program Files/MetaTrader 5/metaeditor64.exe"
# WINE_CMD="wine"
# MT5_COMMON_FILES="$HOME/Library/Application Support/CrossOver/Bottles/MT5/drive_c/users/crossover/AppData/Roaming/MetaQuotes/Terminal/Common/Files"

# --- macOS + нативный билд MT5 от MetaQuotes (metatrader5.com, не CrossOver) ---
# Портативный режим: MQL5/config/Tester лежат прямо внутри "Program Files/MetaTrader 5",
# а не в Roaming, кроме Common\Files - тот всё равно в Roaming.
MT5_DATA_DIR="$HOME/Library/Application Support/net.metaquotes.wine.metatrader5/drive_c/Program Files/MetaTrader 5"
METAEDITOR="$HOME/Library/Application Support/net.metaquotes.wine.metatrader5/drive_c/Program Files/MetaTrader 5/MetaEditor64.exe"
WINE_CMD="/Applications/MetaTrader 5.app/Contents/SharedSupport/wine/bin/wine"
MT5_COMMON_FILES="$HOME/Library/Application Support/net.metaquotes.wine.metatrader5/drive_c/users/user/AppData/Roaming/MetaQuotes/Terminal/Common/Files"

# Без этого wine создаёт новый пустой префикс в ~/.wine вместо того, чтобы
# использовать бутылку MT5, и зависает на первичной инициализации.
export WINEPREFIX="$HOME/Library/Application Support/net.metaquotes.wine.metatrader5"

# --- Linux + Wine: пути аналогичны, меняется только префикс ---
# --- Windows (git bash): WINE_CMD="" и обычные пути C:/... ---
